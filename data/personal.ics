 %3Cbr%3EBis%20n%C3%A4chste%20Woche%2C%5Cr%3Cbr%3Eliebe%20Gr%C3%BC%C3%9Fe
 %5Cr%3Cbr%3E%5Cr%3Cbr%3Ee%5Cr%3Cbr%3E--%20%5Cr%3Cbr%3E%5Cr%3Cbr%3ENicole
