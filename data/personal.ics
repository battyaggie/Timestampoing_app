SUMMARY:FW: Korrektur: Führungskräftelehrgang ab November 2024
TRANSP:OPAQUE
UID:bc6ca253-e7ca-4fe6-9bd9-50822719d7e2
URL;VALUE=URI:mid:003c01db3049$74af8f50$5e0eadf0$@technikum-wien.at
